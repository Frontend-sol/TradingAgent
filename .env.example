# App
NEXT_PUBLIC_APP_NAME=AutoTrading Workbench
NODE_ENV=development
APP_ENCRYPTION_KEY=replace-with-32-char-key

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autotrading?schema=public

# Redis
REDIS_PASSWORD=change-this-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# OKX (Demo default)
OKX_ENV=demo
OKX_DEMO_BASE_URL=https://www.okx.com
OKX_LIVE_BASE_URL=https://www.okx.com
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# LLM default provider
LLM_DEFAULT_PROVIDER=deepseek
LLM_DEFAULT_MODEL=deepseek-reasoner
LLM_API_KEY=sk-1a9ea1b681b64dc09386d1aa8ff6c365
LLM_BASE_URL=https://api.deepseek.com

# Runtime mode: analysis | paper | live
TRADING_RUNTIME_MODE=analysis

# TradingView webhook
TRADINGVIEW_WEBHOOK_SECRET=replace-with-random-token
TRADINGVIEW_ORDER_SIZE=0.01
